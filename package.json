{
  "name": "rahimny",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run && node --test dev-tools/scripts/*.test.mjs",
    "test:watch": "vitest",
    "check": "pnpm check:publication && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm check:tokens && pnpm build",
    "check:publication": "node dev-tools/scripts/check-publication.mjs",
    "check:signal-shutters": "node dev-tools/scripts/check-signal-shutters.mjs",
    "check:home-watcher": "node dev-tools/scripts/check-home-watcher.mjs",
    "check:home-characters": "node dev-tools/scripts/check-home-characters.mjs",
    "profile:signal-shutters": "node dev-tools/scripts/profile-signal-shutters.mjs",
    "check:browser": "pnpm check:home-characters && pnpm check:home-watcher && pnpm check:signal-shutters && pnpm check:masthead-hand && pnpm check:contrast && pnpm check:routes && pnpm check:autonomous-hand && pnpm check:helion && pnpm check:matter-atelier && pnpm check:umbra && pnpm check:aftermatter && pnpm check:mandelbulb && pnpm check:pressure-type && pnpm check:discoveries && pnpm check:nereid && pnpm check:home-nereid && pnpm check:core-panic && pnpm check:filament && pnpm check:octopus && pnpm check:ghost-cambridge && pnpm check:medusa",
    "check:all": "pnpm check && pnpm check:browser",
    "check:routes": "node dev-tools/scripts/check-routes.mjs",
    "check:tokens": "node dev-tools/scripts/check-tokens.mjs",
    "check:contrast": "node dev-tools/scripts/check-contrast.mjs",
    "fonts": "node dev-tools/scripts/fetch-fonts.mjs",
    "posters": "node dev-tools/scripts/capture-posters.mjs",
    "preview": "vite preview",
    "create:experiment": "node dev-tools/scripts/create-experiment.js",
    "create:experiment:webgl": "node dev-tools/scripts/create-experiment.js --type webgl",
    "create:experiment:tsl": "node dev-tools/scripts/create-experiment.js --type tsl",
    "check:autonomous-hand": "node dev-tools/scripts/check-autonomous-hand.mjs",
    "check:masthead-hand": "node dev-tools/scripts/check-masthead-hand.mjs",
    "check:helion": "node dev-tools/scripts/check-helion.mjs",
    "check:matter-atelier": "node dev-tools/scripts/check-matter-atelier.mjs",
    "check:umbra": "node dev-tools/scripts/check-umbra.mjs",
    "check:aftermatter": "node dev-tools/scripts/check-aftermatter.mjs",
    "check:mandelbulb": "node dev-tools/scripts/check-mandelbulb.mjs",
    "check:pressure-type": "node dev-tools/scripts/check-pressure-type.mjs",
    "check:discoveries": "node dev-tools/scripts/check-discoveries.mjs",
    "check:nereid": "node dev-tools/scripts/check-nereid.mjs",
    "check:home-nereid": "node dev-tools/scripts/check-home-nereid.mjs",
    "bake:nereid-home": "node dev-tools/scripts/bake-nereid-home.mjs",
    "poster:nereid-home": "node dev-tools/scripts/capture-nereid-home.mjs",
    "check:core-panic": "node dev-tools/scripts/check-core-panic.mjs",
    "check:filament": "node dev-tools/scripts/check-filament.mjs",
    "bake:filament": "node dev-tools/scripts/bake-filament.mjs",
    "check:octopus": "node dev-tools/scripts/check-octopus.mjs",
    "bake:filament:routes": "node dev-tools/scripts/bake-filament-routes.mjs",
    "check:ghost-cambridge": "node dev-tools/scripts/check-ghost-cambridge.mjs",
    "bake:filament:depth": "node dev-tools/scripts/bake-filament-depth.mjs",
    "check:medusa": "node dev-tools/scripts/check-medusa.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.22-rc.20250304",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-slot": "^1.2.2",
    "@tailwindcss/vite": "^4.1.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.13.0",
    "lucide-react": "^0.511.0",
    "modern-screenshot": "4.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "simplex-noise": "^4.0.3",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.7",
    "three": "^0.185.1",
    "tweakpane": "^4.0.5",
    "vite-plugin-glsl": "^1.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^22.15.18",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "playwright": "^1.62.1",
    "prettier": "3.6.2",
    "sharp": "^0.35.4",
    "tw-animate-css": "^1.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
